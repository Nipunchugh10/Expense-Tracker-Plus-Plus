<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest template for the Microsoft Store.
     {{VERSION}} and {{DISPLAYNAME}} are filled in by packaging\build_msix.ps1.
     Identity Name / Publisher / PublisherDisplayName are the values Partner Center shows under
     Product management > Product identity. They must match exactly or the upload is rejected. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
         IgnorableNamespaces="uap rescap desktop6">
  <Identity Name="NipunChugh.ExpenseTrackerPlusPlus"
            Publisher="CN=6BB67569-0693-4004-9C83-45BD14ED66F5"
            Version="{{VERSION}}"
            ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>{{DISPLAYNAME}}</DisplayName>
    <PublisherDisplayName>Nipun Chugh</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Keep the ledger in the normal %APPDATA%\ExpenseTrackerPlusPlus folder, exactly like the downloaded
         version. Without this, Windows hides new files in a private per-package folder that Explorer
         cannot see ("File > Open data folder" would open the wrong place) and that is DELETED when the
         app is uninstalled, which would silently destroy a user's financial records. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="ExpenseTrackerPlusPlus" Executable="Expense_Tracker_Plus_Plus.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="{{DISPLAYNAME}}"
                          Description="A private, offline-first personal finance tracker: expenses, income, subscriptions, budgets and goals."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                         Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <!-- Needed to download the public exchange rates. No other capability is requested. -->
    <Capability Name="internetClient" />
    <!-- Classic Win32 desktop app (C++/OpenGL) packaged as a full-trust app. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Required by FileSystemWriteVirtualization=disabled above (see the comment there). -->
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
