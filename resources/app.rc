// Windows resources for Expense Tracker Plus Plus.
// "GLFW_ICON" is the name GLFW looks up for the window/taskbar icon; as the
// executable's only icon it is also what Explorer shows for the .exe.
// Regenerate the icon with: powershell -ExecutionPolicy Bypass -File resources\make_icon.ps1
#include <winver.h>

GLFW_ICON ICON "app_icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Nipunchugh10"
            VALUE "FileDescription",  "Expense Tracker Plus Plus"
            VALUE "FileVersion",      "2.0.0"
            VALUE "InternalName",     "Expense_Tracker_Plus_Plus"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "Expense_Tracker_Plus_Plus.exe"
            VALUE "ProductName",      "Expense Tracker Plus Plus"
            VALUE "ProductVersion",   "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
